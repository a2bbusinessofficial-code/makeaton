# ── Database (Supabase → Project Settings → Database → Connection string) ──
# Pooled connection (port 6543) for the app, direct connection (port 5432) for migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase Auth (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon public key>"
SUPABASE_SERVICE_ROLE_KEY="<service_role key — server only, never expose>"

# ── App ──
NEXT_PUBLIC_SITE_URL="https://<your-app>.vercel.app"
# Comma-separated emails that become Admin when they sign up.
ADMIN_EMAILS="you@gmail.com,admin@example.com"
# Shows the demo logins on the login page.
NEXT_PUBLIC_DEMO_MODE="true"
COMPANY_STATE="Gujarat"

# ── Email (Gmail SMTP with an App Password) — invoices, reminders, password-changed ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="<16-character Google app password>"
MAIL_FROM="Brightloop Billing <you@gmail.com>"

# ── Vercel Cron (any long random string) ──
CRON_SECRET="<random string>"

# ── Seed (optional) ──
# SEED_SUBSCRIPTIONS="3000"
# SEED_DEMO_PASSWORD="Brightloop@2026"
